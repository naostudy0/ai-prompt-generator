{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "format": "prettier --write \"**/*.{js,mjs,cjs}\" \"resources/css/**/*.css\"",
        "format:check": "prettier --check \"**/*.{js,mjs,cjs}\" \"resources/css/**/*.css\"",
        "check": "npm run lint && npm run format:check"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.7",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
